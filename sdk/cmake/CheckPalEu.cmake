function(tcnyc_check_pal_eu xbe)
    if(NOT EXISTS "${xbe}")
        message(FATAL_ERROR "Put default.xbe from the second European PAL disc in assets-pal-eu/.")
    endif()
    file(SHA1 "${xbe}" sha1)
    if(NOT sha1 STREQUAL "569ddfb481d929f55a4e37f0322b4f6f59baadff")
        message(FATAL_ERROR "assets-pal-eu/default.xbe is a different revision from the PAL EU profile.")
    endif()
endfunction()
